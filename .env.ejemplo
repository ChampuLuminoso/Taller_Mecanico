# ── Copia este archivo como .env para trabajar en TU computador. ──
# En Railway NO se usa este archivo: las variables se ponen en el panel (pestaña Variables).
# Nunca subas el .env a Git (ya está en .gitignore).

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=solo-para-desarrollo

# Base de datos local (en Railway llega sola como DATABASE_URL)
DB_NAME=taller_francois
DB_USER=taller
DB_PASSWORD=taller
DB_HOST=localhost
DB_PORT=5432

# Enlaces en los correos
URL_SITIO=http://localhost:8000

# Correo: sin RESEND_API_KEY los correos se imprimen en la terminal
# RESEND_API_KEY=re_xxxxxxxx
# DEFAULT_FROM_EMAIL=AutoPartes M&F <avisos@tudominio.co>
# CORREO_RESPUESTA=correo-del-taller@gmail.com

# WhatsApp del jefe para el botón de contacto
WHATSAPP_JEFE=573000000000
